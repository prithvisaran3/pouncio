# Pouncio Local Environment Setup Template
# Copy this file to '.env' and populate with your own configurations.

# Runtime authorization token (Required to run the application)
APP_SECRET_KEY=your_secure_secret_key_here

# Cloud Function trigger manual scraper endpoint URL
SCRAPER_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/pouncioTriggerScrapeJobs

# Firebase Android client credentials
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=1:your_project_number:android:your_app_id
FIREBASE_ANDROID_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_ANDROID_PROJECT_ID=your_project_id
FIREBASE_ANDROID_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Firebase iOS client credentials
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=1:your_project_number:ios:your_app_id
FIREBASE_IOS_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_IOS_PROJECT_ID=your_project_id
FIREBASE_IOS_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_IOS_BUNDLE_ID=com.yourcompany.app
